# Copy this file to ".env" and fill in whichever ONE provider you want to use.
# LiteLLM reads these automatically -- you don't need to touch any code.

# Option A: Groq (fastest, free tier, get a key at https://console.groq.com/keys)
GROQ_API_KEY=

# Option B: Google Gemini (free tier, get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Option C: Ollama (fully local & offline, no key needed)
# Just install Ollama (https://ollama.com) and run: ollama pull qwen2.5:7b-instruct
# OLLAMA_API_BASE=http://localhost:11434
